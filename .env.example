# Optional local overrides. None are required when running from a Git worktree
# with an authenticated Codex CLI on PATH.
NOTEBOOK_AUTHOR=Alex
NOTEBOOK_AI=auto
NOTEBOOK_WORKTREE=
NOTEBOOK_CODEX_CWD=

# Optional remote-repository backend when Notebook is not run from a clone.
GITHUB_TOKEN=
GITHUB_REPO=grantaj/notebook
GITHUB_BRANCH=main

# Explicit metered fallback only; not used when Codex is available in auto mode.
OPENAI_API_KEY=
OPENAI_MODEL=
